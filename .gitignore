*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
secrets.json

# Database dumps / backups — never commit real or exported data
*.sql.gz
*.dump
*.bak
*.backup
*.old

# Editor / OS noise
*.swp
.idea/
.vscode/
