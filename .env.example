# BIK Solutions — environment variable template
#
# This is a static site (no build-time env injection) plus a small set of
# server-side pieces (Cloudflare Worker AI proxy, optional AWS Lambda
# alternative). Copy this file to `.env` for your own local reference only —
# the frontend does not read a root `.env` file at runtime. Never commit a
# file with real values.
#
# ── Supabase (frontend) ──────────────────────────────────────────────────
# NOT secret. The project URL and publishable ("anon") key are meant to be
# public and are intentionally hardcoded in js/supabase/client.js rather
# than injected via env vars, since this is a plain static site with no
# build step. Row Level Security in supabase/migrations/ is the real
# security boundary — see js/supabase/client.js for the current values.
# Listed here only for reference/documentation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NEVER set this in any file read by the browser. Only ever used from a
# trusted server context (e.g. a one-off admin script run locally, never
# committed with a real value).
# SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Worker (cloudflare-worker/) — AI proxy ────────────────────
# Real value is set with `wrangler secret put ANTHROPIC_API_KEY` and stored
# encrypted by Cloudflare — never in a committed file. For local `wrangler
# dev` testing only, create cloudflare-worker/.dev.vars (already
# git-ignored) — see cloudflare-worker/.dev.vars.example.
ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=https://biksolutions.com.au

# ── Cloudflare Worker (cloudflare-worker-xero/) — Xero OAuth2 proxy ──────
# Real values are set with `wrangler secret put <NAME>` (see
# cloudflare-worker-xero/wrangler.toml header) and stored encrypted by
# Cloudflare — never in a committed file. For local `wrangler dev` testing
# only, create cloudflare-worker-xero/.dev.vars (already git-ignored) —
# see cloudflare-worker-xero/.dev.vars.example.
# XERO_CLIENT_ID and XERO_CLIENT_SECRET come from the Xero app created at
# developer.xero.com — the app's redirect URI must be set to exactly
# <WORKER_BASE_URL>/callback (see cloudflare-worker-xero/wrangler.toml).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Any long random string (e.g. `openssl rand -hex 32`) — signs the OAuth
# state param, not a Xero-provided value.
XERO_STATE_SECRET=
# Same service_role key as the rest of this project — never in any file
# under js/, only ever as a Worker secret.
# SUPABASE_SERVICE_ROLE_KEY=
