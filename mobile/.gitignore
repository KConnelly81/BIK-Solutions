# Node
node_modules/
npm-debug.log*

# Generated by scripts/sync-shared.js — regenerated from the real source of
# truth in ../js/ before every build (npm run sync). Never hand-edit or
# commit copies here; see scripts/sync-shared.js's header.
www/js/shared/

# Android build outputs (not the platform project itself — that IS committed,
# standard Capacitor practice, so CI/Codemagic and Android Studio both see
# the exact native project this app ships with).
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.keystore
*.jks

# iOS build outputs / CocoaPods (Pods/ is regenerated by `pod install` in
# CI and in Xcode — the Podfile and Podfile.lock ARE committed).
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
*.ipa
*.dSYM.zip

# Secrets — never committed, ever (see codemagic.yaml's env-var groups
# instead, and cloudflare-worker/.gitignore for the same convention
# elsewhere in this repo).
.env
.env.local
google-services.json
GoogleService-Info.plist
*.p12
*.mobileprovision
